[Unit]
Description=SMJ Project Dashboard
After=network.target

[Service]
User=smj
Group=smj
WorkingDirectory=/var/www/smj
EnvironmentFile=/etc/smj.env
ExecStart=/usr/bin/node scripts/vps-server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=smj
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smj
RestrictSUIDSGID=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
